{
  "name": "ventprom-projects",
  "displayName": "ВЕНТПРОМ — проекты в работе",
  "description": "Панель слева: сессии Claude на этом ПК и все проекты из PROJECTS.md на сервере.",
  "version": "1.2.0",
  "publisher": "ventprom",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ventpromProjects",
          "title": "ПРОЕКТЫ ВЕНТПРОМ",
          "icon": "media/vp.svg"
        }
      ]
    },
    "views": {
      "ventpromProjects": [
        {
          "id": "ventpromProjects.sessions",
          "name": "Сессии Claude",
          "icon": "media/vp.svg"
        },
        {
          "id": "ventpromProjects.tree",
          "name": "В работе",
          "icon": "media/vp.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "ventpromProjects.refresh",
        "title": "Обновить с сервера",
        "icon": "$(refresh)",
        "category": "ПРОЕКТЫ"
      },
      {
        "command": "ventpromProjects.openBlock",
        "title": "Открыть блок проекта",
        "category": "ПРОЕКТЫ"
      },
      {
        "command": "ventpromProjects.openFull",
        "title": "Открыть весь PROJECTS.md (копия)",
        "icon": "$(book)",
        "category": "ПРОЕКТЫ"
      },
      {
        "command": "ventpromProjects.copyStart",
        "title": "Скопировать команду «Начать»",
        "icon": "$(clippy)",
        "category": "ПРОЕКТЫ"
      },
      {
        "command": "ventpromProjects.cycleFilter",
        "title": "Фильтр: всё / только готовое / только активное",
        "icon": "$(filter)",
        "category": "ПРОЕКТЫ"
      },
      {
        "command": "ventpromProjects.refreshSessions",
        "title": "Обновить список сессий",
        "icon": "$(refresh)",
        "category": "ПРОЕКТЫ"
      },
      {
        "command": "ventpromProjects.openSession",
        "title": "Открыть сессию",
        "category": "ПРОЕКТЫ"
      },
      {
        "command": "ventpromProjects.copySessionName",
        "title": "Скопировать имя для связи",
        "icon": "$(clippy)",
        "category": "ПРОЕКТЫ"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ventpromProjects.refresh",
          "when": "view == ventpromProjects.tree",
          "group": "navigation@1"
        },
        {
          "command": "ventpromProjects.cycleFilter",
          "when": "view == ventpromProjects.tree",
          "group": "navigation@2"
        },
        {
          "command": "ventpromProjects.openFull",
          "when": "view == ventpromProjects.tree",
          "group": "navigation@3"
        },
        {
          "command": "ventpromProjects.refreshSessions",
          "when": "view == ventpromProjects.sessions",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ventpromProjects.copyStart",
          "when": "view == ventpromProjects.tree && viewItem == vpProject",
          "group": "inline"
        },
        {
          "command": "ventpromProjects.copySessionName",
          "when": "view == ventpromProjects.sessions && viewItem == vpSession",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "ПРОЕКТЫ ВЕНТПРОМ",
      "properties": {
        "ventpromProjects.sshExe": {
          "type": "string",
          "default": "C:/Windows/System32/OpenSSH/ssh.exe",
          "description": "Путь к НАТИВНОМУ Windows ssh.exe (не из Git Bash)."
        },
        "ventpromProjects.host": {
          "type": "string",
          "default": "",
          "description": "Сервер с реестром в виде user@host или имя из ~/.ssh/config. Задаётся локально — в коде адреса нет."
        },
        "ventpromProjects.remotePath": {
          "type": "string",
          "default": "~/PROJECTS.md",
          "description": "Путь к PROJECTS.md на сервере."
        },
        "ventpromProjects.refreshMinutes": {
          "type": "number",
          "default": 10,
          "description": "Автообновление, минут. 0 — только по кнопке."
        },
        "ventpromProjects.activeDays": {
          "type": "number",
          "default": 30,
          "description": "Блок без явного статуса считается «в работе», если последняя дата в нём свежее этого числа дней."
        },
        "ventpromProjects.timeoutSeconds": {
          "type": "number",
          "default": 10,
          "description": "Таймаут ssh. При VPN-проблемах панель покажет кэш."
        },
        "ventpromProjects.filter": {
          "type": "string",
          "enum": [
            "all",
            "ready",
            "work"
          ],
          "enumDescriptions": [
            "Все группы",
            "Только то, что ждёт тебя",
            "Готовое и в работе"
          ],
          "default": "all",
          "description": "Что показывать в панели; переключается кнопкой-воронкой в шапке."
        }
      }
    }
  }
}